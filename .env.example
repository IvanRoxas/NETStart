# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret_here

# Database Configuration (Docker Postgres Service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=netstart
DATABASE_URL="postgres://postgres:postgres@db:5432/netstart"

# Admin Seed Password
ADMIN_SEED_PASSWORD=dev_admin_temp_2026

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube Integration (Optional - when unset or empty, falls back to curated local video data)
YOUTUBE_API_KEY=

# Gemini AI Integration
# Note: GEMINI_MODEL has no code default; must be explicitly specified (e.g. gemini-2.5-flash)
GEMINI_API_KEY=
GEMINI_MODEL=
# GEMINI_TIMEOUT_SECONDS default: 45
GEMINI_TIMEOUT_SECONDS=45
# GEMINI_THINKING_LEVEL default: LOW (options: LOW, HIGH, OFF)
GEMINI_THINKING_LEVEL=LOW

# Aptitude Background Retry Configuration
# GEMINI_MAX_RETRIES default: 5
GEMINI_MAX_RETRIES=5
# GEMINI_RETRY_COOLDOWN_MIN default: 10
GEMINI_RETRY_COOLDOWN_MIN=10
