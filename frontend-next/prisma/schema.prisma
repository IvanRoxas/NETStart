generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid()) @map("user_id")
  name          String?   @map("username")
  displayName   String?   @unique @map("display_name")
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  password      String?
  image         String?
  banner        String?
  status        String?
  bio           String?   @db.Text
  isBanned      Boolean   @default(false) @map("is_banned")
  createdAt     DateTime  @default(now()) @map("created_at")
  showcasedBadges String[] @default([])
  
  // Verification, Aptitude & Gamification Fields
  studentId     String?   @unique @map("student_id")
  isVerified    Boolean   @default(false) @map("is_verified")
  hasTakenAptitudeTest Boolean @default(false) @map("has_taken_aptitude_test")
  logicScore    Int?      @map("logic_score")
  patternRecognitionScore Int? @map("pattern_recognition_score")
  recommendedLearningPath String? @map("recommended_learning_path")
  xp            Int       @default(0)
  gears         Int       @default(0)
  verifiedRewardClaimed Boolean @default(false) @map("verified_reward_claimed")
  activeTitle   String?   @default("Novice Explorer") @map("active_title")
  
  accounts      Account[]
  sessions      Session[]
  reports       Report[]

  friendshipsSent     Friendship[] @relation("FriendshipsSent")
  friendshipsReceived Friendship[] @relation("FriendshipsReceived")
  notifications       Notification[] @relation("AppNotifications")
  sentNotifications   Notification[] @relation("SentNotifications")

  // Gamification Relations
  userAchievements    UserAchievement[]
  missionProgresses   MissionProgress[]

  // Shop Relations
  inventory           UserInventory[]

  @@map("users")
}

model Achievement {
  id          String   @id @default(cuid())
  name        String
  description String
  iconUrl     String   @map("icon_url")
  xpReward    Int      @default(100) @map("xp_reward")
  gearsReward Int      @default(0) @map("gears_reward")
  triggerCode String   @unique @map("trigger_code")

  users       UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  userId        String @map("user_id")
  achievementId String @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@map("user_achievements")
}

model MissionProgress {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  missionId     String    @map("mission_id")
  status        String    @default("IN_PROGRESS")
  submittedCode String?   @db.Text @map("submitted_code")
  completedAt   DateTime? @map("completed_at")
  startedAt     DateTime  @default(now()) @map("started_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("mission_progresses")
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  friendId  String   @map("friend_id")
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation("FriendshipsSent", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendshipsReceived", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@map("friendships")
}

model Notification {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  senderId         String?   @map("sender_id")
  notificationType String    @map("notification_type")
  data             Json?
  readAt           DateTime? @map("read_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user   User  @relation("AppNotifications", fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@map("notifications")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, code])
  @@map("verification_codes")
}

model ShopItem {
  id          String   @id @default(cuid())
  title       String
  type        String
  category    String
  subCategory String   @map("sub_category")
  price       Int
  imageUrl    String   @map("image_url")

  inventories UserInventory[]

  @@map("shop_items")
}

model UserInventory {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  shopItemId  String   @map("shop_item_id")
  isEquipped  Boolean  @default(false) @map("is_equipped")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem    ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)

  @@unique([userId, shopItemId])
  @@map("user_inventories")
}

model SystemAdmin {
  id                  String    @id @default(cuid())
  username            String    @unique
  password            String
  createdAt           DateTime  @default(now()) @map("created_at")
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
}

model SystemLog {
  id           String   @id @default(cuid())
  actorId      String   @map("actor_id")
  actorRole    String   @map("actor_role")
  action       String
  targetUserId String?  @map("target_user_id")
  details      String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("system_logs")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String   @map("actor_id")
  actorRole    String   @map("actor_role")
  action       String
  targetUserId String?  @map("target_user_id")
  details      String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model AptitudeQuestion {
  id            String   @id @default(cuid())
  question      String   @db.Text
  questionType  String   @default("MULTIPLE_CHOICE") @map("question_type") // MULTIPLE_CHOICE, TRUE_FALSE, SHORT_ANSWER
  category      String   // LOGIC, PATTERN, CODING_READINESS
  options       Json     // Array of option strings
  correctAnswer Int      @default(0) @map("correct_answer")
  shortAnswer   String?  @map("short_answer") @db.Text
  explanation   String?  @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("aptitude_questions")
}

model Report {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String
  description String   @db.Text
  attachments String[] @default([])
  status      String   @default("PENDING")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reports")
}

