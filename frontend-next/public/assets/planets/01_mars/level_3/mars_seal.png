<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="100%" height="100%">
  <defs>
    <radialGradient id="marsCore" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ff6b4a"/>
      <stop offset="60%" stop-color="#d9381e"/>
      <stop offset="90%" stop-color="#8a1c0e"/>
      <stop offset="100%" stop-color="#400b05"/>
    </radialGradient>
    <linearGradient id="goldRing" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fef08a"/>
      <stop offset="40%" stop-color="#f59e0b"/>
      <stop offset="70%" stop-color="#d97706"/>
      <stop offset="100%" stop-color="#b45309"/>
    </linearGradient>
    <linearGradient id="shieldRim" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8"/>
      <stop offset="100%" stop-color="#0369a1"/>
    </linearGradient>
    <filter id="sealGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Outer Starburst Crest Ring -->
  <circle cx="200" cy="200" r="190" fill="#0d041a" stroke="url(#goldRing)" stroke-width="8" filter="url(#sealGlow)"/>
  <circle cx="200" cy="200" r="172" fill="none" stroke="#fef08a" stroke-width="2" stroke-dasharray="6,4"/>

  <!-- Mars Planet Sphere -->
  <circle cx="200" cy="200" r="140" fill="url(#marsCore)" stroke="url(#goldRing)" stroke-width="4"/>

  <!-- Surface Craters and Topography -->
  <ellipse cx="160" cy="160" rx="35" ry="18" fill="#78140a" opacity="0.6"/>
  <ellipse cx="240" cy="220" rx="45" ry="22" fill="#78140a" opacity="0.5"/>
  <ellipse cx="180" cy="250" rx="25" ry="12" fill="#5c0e07" opacity="0.7"/>
  <!-- Ice Cap -->
  <path d="M170,62 Q200,82 230,62 Q215,60 200,60 Q185,60 170,62 Z" fill="#e0f2fe" opacity="0.85"/>

  <!-- Orbital Ring Axis -->
  <ellipse cx="200" cy="200" rx="160" ry="48" fill="none" stroke="url(#shieldRim)" stroke-width="5" transform="rotate(-25 200 200)"/>

  <!-- Satellite / Relay Icon at Top -->
  <g transform="translate(200, 105) scale(0.9)">
    <circle cx="0" cy="0" r="16" fill="#f59e0b" stroke="#fff" stroke-width="2"/>
    <path d="M-12,-6 L12,-6 L8,6 L-8,6 Z" fill="#38bdf8"/>
    <line x1="0" y1="0" x2="0" y2="-20" stroke="#fef08a" stroke-width="3"/>
    <circle cx="0" cy="-20" r="4" fill="#ef4444"/>
  </g>

  <!-- Banner Ribbon for Colony Crest -->
  <path d="M80,285 L140,270 L260,270 L320,285 L300,320 L200,310 L100,320 Z" fill="#1e1035" stroke="url(#goldRing)" stroke-width="3"/>
  <text x="200" y="296" text-anchor="middle" font-family="'Inter', sans-serif" font-weight="900" font-size="16" fill="#fef08a" letter-spacing="2">OFFICIAL MARS SEAL</text>
  <text x="200" y="338" text-anchor="middle" font-family="'Inter', sans-serif" font-weight="700" font-size="11" fill="#38bdf8" letter-spacing="3">ASTROLINK VERIFIED</text>
</svg>
